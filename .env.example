# ──── Payload CMS ─────────────────────────────────────────────────────────────

# Secret used to sign Payload sessions and tokens.
# Generate a fresh one with: openssl rand -base64 48
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# SQLite connection string.
# Dev:  file:./payload.db
# Prod: file:/data/payload.db (volume-backed, see docker-compose.yml)
DATABASE_URI=file:./payload.db

# Public URL of the site. Used for CORS, CSRF, and metadata.
SITE_URL=http://localhost:3000
