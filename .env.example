# ──── Payload CMS ─────────────────────────────────────────────────────────────

# Secret used to sign Payload sessions and tokens.
# Generate a fresh one with: openssl rand -base64 48
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# SQLite connection string.
# Dev:  file:./payload.db
# Prod: file:/data/payload.db (volume-backed, see docker-compose.yml)
DATABASE_URI=file:./payload.db

# Public URL of the site. Used for CORS, CSRF, and metadata.
SITE_URL=http://localhost:3000

# ──── First admin (auto-created on first boot if the users table is empty) ────

ADMIN_EMAIL=lucas@example.com
ADMIN_PASSWORD=change-me

# ──── Production / Traefik ────────────────────────────────────────────────────

# Public hostname (no scheme), used by Traefik routing labels.
SITE_HOST=lucasdesfontaine.dev

# CIDR list authorised to reach /admin and /api. Comma-separated.
# Examples:
#   - Fixed home/office IP:   1.2.3.4/32
#   - Tailscale tailnet:      100.64.0.0/10
#   - Several:                1.2.3.4/32,5.6.7.8/32
# Set to 0.0.0.0/0 only for a local docker-compose smoke test.
ADMIN_ALLOWED_IPS=0.0.0.0/0

# ──── Backup (optional, used by scripts/backup.sh) ────────────────────────────

# rclone remote name to sync snapshots to. Empty = local snapshots only.
# Example: b2:portfolio-backups
RCLONE_REMOTE=
