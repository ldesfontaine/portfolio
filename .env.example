# --- Payload CMS ---

# Secret used to sign Payload sessions and tokens. Generate with `openssl rand -base64 32`.
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# SQLite connection string. Use file:./payload.db in dev, file:/data/payload.db in production.
DATABASE_URI=file:./payload.db

# Public URL of the site. Used for CORS, CSRF, and metadata.
SITE_URL=http://localhost:3000

# --- First admin (used by scripts/create-admin.ts in Step 5; unused for now) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
