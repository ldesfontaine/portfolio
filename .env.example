# ──── Payload CMS ─────────────────────────────────────────────────────────────

# Secret used to sign Payload sessions and tokens.
# Generate a fresh one with: openssl rand -base64 48
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# SQLite connection string.
# Dev:  file:./payload.db
# Prod: file:/data/payload.db (volume-backed, see docker-compose.yml)
DATABASE_URI=file:./payload.db

# Public URL of the site. Used for CORS, CSRF, and metadata.
# Prod (with Traefik apex→subdomain 301): https://portfolio.ldesfontaine.com
SITE_URL=http://localhost:3000

# Comma-separated extra origins to add to CORS/CSRF allowlists.
EXTRA_ORIGINS=


# ──── GoatCounter (analytics bundled in the same image) ───────────────────────

# Dev:  localhost.local
# Prod: portfolio.ldesfontaine.com
GOATCOUNTER_VHOST=localhost.local

