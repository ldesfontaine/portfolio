{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "seed": "payload run scripts/seed.ts",
    "seed:docker": "docker run --rm -u \"$(id -u):$(id -g)\" -v \"$(pwd):/app\" --env-file .env -w /app node:22-slim sh -c 'npm ci --silent && npx payload run scripts/seed.ts'",
    "generate:types:docker": "docker run --rm -u \"$(id -u):$(id -g)\" -v \"$(pwd):/app\" -w /app node:22-slim sh -c 'npm ci --silent && npx payload generate:types'",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/translations": "^3.84.1",
    "graphql": "^16.14.0",
    "next": "~15.4.11",
    "payload": "^3.84.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9",
    "eslint-config-next": "^15.3.1",
    "gray-matter": "^4.0.3",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "unified": "^11.0.5"
  }
}
