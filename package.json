{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "generate:types:docker": "docker run --rm -u \"$(id -u):$(id -g)\" -v \"$(pwd):/app\" -w /app node:22-slim sh -c 'npm ci --silent && npx payload generate:types'",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/translations": "3.86.0",
    "graphql": "^16.14.0",
    "next": "16.2.11",
    "payload": "3.86.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3"
  }
}
